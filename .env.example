# ==========================================
# Real-Time Voice Agent Environment Config
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# 1. Speech-to-Text (STT) - AssemblyAI
# Get your key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# 2. Text-to-Speech (TTS) - ElevenLabs
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default voice)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# 3. LLM Providers (Bring Your Own LLM)
# Choose your preferred provider (openai | gemini | anthropic | groq | mock)
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Key: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq API Key (Ultra-fast Llama): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Agent Persona / System Preset
# Presets: customer_support | sales | healthcare | smart_home | enterprise_knowledge
AGENT_PRESET=customer_support
